---
// Landing temporal mientras se arma el sitio completo (ver _home.astro).
// Estética inspirada en posthog.com, llevada a un escritorio retro tipo Mac clásico / Win95.
import { execSync } from 'node:child_process';

const redes = [
  { label: 'GitHub', href: 'https://github.com/jbecerra73', color: 'var(--blue)' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/joaquin-becerra-5b3388201', color: 'var(--yellow)' },
  { label: 'X', href: 'https://x.com/joaquinbecerra_', color: 'var(--red)' },
];

let build = 'dev';
try {
  build = (process.env.GITHUB_SHA ?? execSync('git rev-parse HEAD').toString()).trim().slice(0, 7);
} catch {}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Joaquín Becerra</title>
    <meta name="description" content="Joaquín Becerra, software engineer. Site under construction." />
    <link rel="canonical" href="https://joaquinbecerra.me/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Joaquín Becerra" />
    <meta property="og:description" content="Software engineer. Site under construction." />
    <meta property="og:url" content="https://joaquinbecerra.me/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Jersey+20&family=Silkscreen&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="menubar">
      <a href="/" class="brand">
        <span class="mark" aria-hidden="true">JB</span>
        joaquinbecerra.me
      </a>
      <nav class="menus" aria-label="Site info">
        <span>Route <code>/</code></span>
        <span>Build <code>{build}</code></span>
      </nav>
      <span class="status"><i></i> Under construction</span>
      <time id="clock" class="clock">--:--</time>
    </header>

    <div class="desktop">
      <ul class="icons" aria-label="Shortcuts">
        <li>
          <button type="button" class="icon" id="reopen" aria-label="Open hello.md">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 1h7v1h1v1h1v1h1v11H3z" fill="var(--fg)" />
              <path d="M4 2h5v3h3v9H4z" fill="var(--paper)" />
              <path d="M10 2h1v1h1v1h-2z" fill="var(--muted)" />
              <path d="M5 7h6v1H5zM5 9h6v1H5zM5 11h4v1H5z" fill="var(--muted)" />
            </svg>
            <span>hello.md</span>
          </button>
        </li>
        {
          redes.map((r) => (
            <li>
              <a class="icon" href={r.href} target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M1 3h6v1h1v1h7v9H1z" fill="var(--fg)" />
                  <path d="M2 4h4v1h1v1h7v7H2z" fill={r.color} />
                  <path d="M2 6h12v1H2z" fill="var(--fg)" />
                  <path d="M2 7h12v1H2z" fill="#fff" fill-opacity="0.35" />
                </svg>
                <span>{r.label} ↗</span>
              </a>
            </li>
          ))
        }
      </ul>

      <article class="window" id="win" aria-labelledby="name">
        <div class="titlebar" id="titlebar">
          <span class="controls">
            <button type="button" id="close" aria-label="Close window"></button>
          </span>
          <span class="title">hello.md</span>
        </div>
        <div class="body">
          <p class="kicker">&gt; Software engineer</p>
          <h1 id="name">Joaquín <mark>Becerra</mark></h1>
          <p class="lead">
            I’m building this site. In the meantime, open one of the folders on the desktop to
            find me elsewhere.
          </p>

          <div class="progress" aria-live="polite">
            <div class="row">
              <span>Loading site…</span>
              <span class="soon">soon<span class="caret">_</span></span>
            </div>
            <span class="bar" aria-hidden="true"><span></span></span>
          </div>

          <div class="actions">
            <a class="btn primary" href={redes[0].href} target="_blank" rel="noopener">View GitHub</a>
            <a class="btn" href={redes[1].href} target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
      </article>
    </div>

    <style is:global>
      :root {
        --bg: #eeefe9;
        --dither: #d6d8ce;
        --bar: #e5e7e0;
        --paper: #fdfdf8;
        --fg: #151515;
        --muted: #65675e;
        --red: #f54e00;
        --yellow: #f7a501;
        --blue: #1d4aff;
        --pixel: 'Silkscreen', ui-monospace, monospace;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1d1f27;
          --dither: #2a2d38;
          --bar: #23252f;
          --paper: #2a2c36;
          --fg: #eeefe9;
          --muted: #9fa1a8;
          --red: #f1662c;
          --yellow: #f7b32b;
          --blue: #5c7cff;
          color-scheme: dark;
        }
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        background-color: var(--bg);
        /* Fondo de escritorio con tramado (dithering) de 2px, como los patrones de System 7. */
        background-image:
          linear-gradient(45deg, var(--dither) 25%, transparent 25%, transparent 75%, var(--dither) 75%),
          linear-gradient(45deg, var(--dither) 25%, transparent 25%, transparent 75%, var(--dither) 75%);
        background-size: 4px 4px;
        background-position:
          0 0,
          2px 2px;
        color: var(--fg);
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 14px;
        line-height: 1.55;
        display: grid;
        grid-template-rows: auto 1fr;
        overflow: hidden;
      }
      /* Líneas de barrido muy tenues encima de todo, como un monitor CRT. */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 10;
        background: repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.04) 2px 3px);
      }
      a {
        color: inherit;
      }
      code {
        font-family: inherit;
      }

      .menubar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        height: 2.25rem;
        padding: 0 1rem;
        background: var(--paper);
        border-bottom: 2px solid var(--fg);
        font-family: var(--pixel);
        font-size: 12px;
        position: relative;
        z-index: 2;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
      }
      .mark {
        display: grid;
        place-items: center;
        width: 1.4rem;
        height: 1.4rem;
        border: 2px solid var(--fg);
        background: var(--red);
        color: #fff;
        font-size: 9px;
      }
      .menus {
        display: flex;
        gap: 1.5rem;
        color: var(--muted);
      }
      .menus code {
        color: var(--fg);
      }
      .status {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
      }
      .status i {
        width: 8px;
        height: 8px;
        background: var(--red);
        animation: blink 1s steps(1) infinite;
      }

      .desktop {
        position: relative;
        min-height: 0;
      }

      .icons {
        list-style: none;
        margin: 0;
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: max-content;
      }
      .icon {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.35rem;
        width: 5.5rem;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font-family: var(--pixel);
        font-size: 11px;
        white-space: nowrap;
        text-decoration: none;
        cursor: pointer;
      }
      .icon svg {
        width: 3rem;
        height: 3rem;
        shape-rendering: crispEdges;
      }
      .icon span {
        padding: 0 0.3rem;
        background: var(--bg);
      }
      /* Selección "invertida" como en los escritorios clásicos. */
      .icon:hover span,
      .icon:focus-visible span {
        background: var(--fg);
        color: var(--bg);
      }
      .icon:focus-visible {
        outline: none;
      }
      .icon:hover svg,
      .icon:focus-visible svg {
        filter: invert(0.15);
      }

      .window {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(40rem, calc(100vw - 2rem));
        background: var(--paper);
        border: 2px solid var(--fg);
        box-shadow: 6px 6px 0 var(--fg);
        transform: translate(-50%, -50%);
      }
      .window.dragging {
        box-shadow: 10px 10px 0 var(--fg);
      }
      .window[hidden] {
        display: none;
      }
      /* Barra de título rayada con el nombre en un recuadro liso, estilo Mac clásico. */
      .titlebar {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 1.9rem;
        padding: 0 0.5rem;
        border-bottom: 2px solid var(--fg);
        background:
          repeating-linear-gradient(var(--fg) 0 1px, transparent 1px 3px) center / calc(100% - 12px) 13px no-repeat,
          var(--paper);
        font-family: var(--pixel);
        font-size: 12px;
        cursor: grab;
        user-select: none;
        touch-action: none;
      }
      .window.dragging .titlebar {
        cursor: grabbing;
      }
      .title {
        padding: 0 0.6rem;
        background: var(--paper);
      }
      .controls {
        position: absolute;
        left: 0.9rem;
        display: flex;
        padding: 0 0.3rem;
        background: var(--paper);
      }
      .controls button {
        width: 14px;
        height: 14px;
        padding: 0;
        border: 2px solid var(--fg);
        background: var(--paper);
        cursor: pointer;
      }
      .controls button:hover,
      .controls button:active {
        background: var(--fg);
      }

      .body {
        padding: 2rem 2.25rem 2.25rem;
      }
      .kicker {
        margin: 0 0 0.6rem;
        color: var(--red);
        font-family: var(--pixel);
        font-size: 13px;
      }
      h1 {
        margin: 0;
        font-family: 'Jersey 20', var(--pixel);
        font-size: clamp(3.25rem, 10vw, 6rem);
        font-weight: 400;
        line-height: 1;
      }
      h1 mark {
        padding: 0 0.12em;
        background: var(--yellow);
        color: #151515;
        box-shadow: 4px 4px 0 var(--fg);
      }
      .lead {
        margin: 1.25rem 0 0;
        max-width: 32rem;
        color: var(--muted);
      }

      .progress {
        margin-top: 1.75rem;
        font-family: var(--pixel);
        font-size: 11px;
      }
      .progress .row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.4rem;
      }
      .caret {
        animation: blink 1s steps(1) infinite;
      }
      /* Barra que se llena de a bloques, como un instalador viejo. */
      .bar {
        display: block;
        height: 1.1rem;
        padding: 2px;
        border: 2px solid var(--fg);
        background: var(--paper);
      }
      .bar span {
        display: block;
        height: 100%;
        width: 0;
        background: repeating-linear-gradient(90deg, var(--blue) 0 10px, transparent 10px 12px);
        animation: fill 4s steps(16, end) infinite;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 1.75rem;
      }
      .btn {
        display: inline-block;
        padding: 0.5rem 1rem;
        border: 2px solid var(--fg);
        background: var(--paper);
        box-shadow: 3px 3px 0 var(--fg);
        color: var(--fg);
        font-family: var(--pixel);
        font-size: 13px;
        text-decoration: none;
      }
      .btn.primary {
        background: var(--yellow);
        color: #151515;
      }
      .btn:hover {
        background: var(--fg);
        color: var(--bg);
      }
      .btn:active {
        transform: translate(3px, 3px);
        box-shadow: none;
      }

      @media (max-width: 700px) {
        body {
          overflow: auto;
        }
        .menubar {
          gap: 0.75rem;
          font-size: 10px;
          white-space: nowrap;
        }
        .menus,
        .clock {
          display: none;
        }
        .desktop {
          display: flex;
          flex-direction: column-reverse;
          justify-content: flex-end;
          gap: 1.25rem;
          padding: 1rem 1.25rem 1rem 1rem;
        }
        .window {
          position: static;
          width: 100%;
          transform: none !important;
        }
        .titlebar {
          cursor: default;
        }
        .body {
          padding: 1.5rem 1.25rem;
        }
        .icons {
          flex-direction: row;
          flex-wrap: wrap;
          width: auto;
          padding: 0;
        }
        .icon {
          width: 4.75rem;
        }
      }

      @keyframes fill {
        to {
          width: 100%;
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
        }
        .bar span {
          width: 60%;
        }
      }
    </style>

    <script>
      const win = document.getElementById('win')!;
      const titlebar = document.getElementById('titlebar')!;
      const clock = document.getElementById('clock')!;
      const mobile = matchMedia('(max-width: 700px)');

      // Ventana arrastrable desde la barra de título, limitada al escritorio.
      // Se guarda el desplazamiento respecto del centro para que siga centrada al redimensionar.
      const offset = { x: 0, y: 0 };
      let start: { x: number; y: number; ox: number; oy: number } | null = null;

      function place() {
        const desk = win.parentElement!.getBoundingClientRect();
        const maxX = Math.max(0, (desk.width - win.offsetWidth) / 2);
        const maxY = Math.max(0, (desk.height - win.offsetHeight) / 2);
        offset.x = Math.max(-maxX, Math.min(maxX, offset.x));
        offset.y = Math.max(-maxY, Math.min(maxY, offset.y));
        win.style.transform = `translate(calc(-50% + ${offset.x}px), calc(-50% + ${offset.y}px))`;
      }

      titlebar.addEventListener('pointerdown', (e) => {
        if (mobile.matches || (e.target as HTMLElement).closest('button')) return;
        start = { x: e.clientX, y: e.clientY, ox: offset.x, oy: offset.y };
        titlebar.setPointerCapture(e.pointerId);
        win.classList.add('dragging');
      });
      titlebar.addEventListener('pointermove', (e) => {
        if (!start) return;
        offset.x = start.ox + e.clientX - start.x;
        offset.y = start.oy + e.clientY - start.y;
        place();
      });
      const stop = () => {
        start = null;
        win.classList.remove('dragging');
      };
      titlebar.addEventListener('pointerup', stop);
      titlebar.addEventListener('pointercancel', stop);
      addEventListener('resize', () => {
        if (!mobile.matches) place();
      });

      // Cerrar la ventana y volver a abrirla desde el ícono del escritorio.
      document.getElementById('close')!.addEventListener('click', () => {
        win.hidden = true;
      });
      document.getElementById('reopen')!.addEventListener('click', () => {
        win.hidden = false;
        offset.x = offset.y = 0;
        if (!mobile.matches) place();
      });

      function tick() {
        clock.textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false });
      }
      tick();
      setInterval(tick, 10_000);
    </script>
  </body>
</html>
