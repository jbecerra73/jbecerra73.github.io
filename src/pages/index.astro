---
// Landing temporal mientras se arma el sitio completo (ver _home.astro).
// Estética inspirada en posthog.com: escritorio con barra de menú, íconos y ventanas.
import { execSync } from 'node:child_process';

const redes = [
  { label: 'GitHub', href: 'https://github.com/jbecerra73', color: 'var(--blue)' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/joaquin-becerra-5b3388201', color: 'var(--yellow)' },
  { label: 'X', href: 'https://x.com/joaquinbecerra_', color: 'var(--red)' },
];

let build = 'dev';
try {
  build = (process.env.GITHUB_SHA ?? execSync('git rev-parse HEAD').toString()).trim().slice(0, 7);
} catch {}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Joaquín Becerra</title>
    <meta name="description" content="Joaquín Becerra, software engineer. Sitio en construcción." />
    <link rel="canonical" href="https://joaquinbecerra.me/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Joaquín Becerra" />
    <meta property="og:description" content="Software engineer. Sitio en construcción." />
    <meta property="og:url" content="https://joaquinbecerra.me/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="menubar">
      <a href="/" class="brand">
        <span class="mark" aria-hidden="true">JB</span>
        joaquinbecerra.me
      </a>
      <nav class="menus" aria-label="Información del sitio">
        <span>Ruta <code>/</code></span>
        <span>Build <code>{build}</code></span>
      </nav>
      <span class="status"><i></i> En construcción</span>
      <time id="clock" class="clock">--:--</time>
    </header>

    <div class="desktop">
      <ul class="icons" aria-label="Accesos">
        <li>
          <button type="button" class="icon" id="reopen" aria-label="Abrir hola.md">
            <svg viewBox="0 0 48 48" aria-hidden="true">
              <path d="M10 4h20l10 10v30H10z" fill="var(--paper)" stroke="var(--fg)" stroke-width="2" />
              <path d="M30 4v10h10" fill="none" stroke="var(--fg)" stroke-width="2" />
              <path d="M16 24h16M16 30h16M16 36h10" stroke="var(--muted)" stroke-width="2" />
            </svg>
            <span>hola.md</span>
          </button>
        </li>
        {
          redes.map((r) => (
            <li>
              <a class="icon" href={r.href} target="_blank" rel="noopener">
                <svg viewBox="0 0 48 48" aria-hidden="true">
                  <path d="M4 12h16l4 4h20v26H4z" fill={r.color} stroke="var(--fg)" stroke-width="2" />
                  <path d="M4 20h40" stroke="var(--fg)" stroke-width="2" />
                </svg>
                <span>{r.label} ↗</span>
              </a>
            </li>
          ))
        }
      </ul>

      <article class="window" id="win" aria-labelledby="name">
        <div class="titlebar" id="titlebar">
          <span class="title">hola.md</span>
          <span class="controls">
            <button type="button" id="close" aria-label="Cerrar ventana">✕</button>
          </span>
        </div>
        <div class="body">
          <p class="kicker">Software engineer</p>
          <h1 id="name">Joaquín <mark>Becerra</mark></h1>
          <p class="lead">
            Estoy armando este sitio. Mientras tanto, abrí alguna carpeta del escritorio para
            encontrarme en otro lado.
          </p>

          <div class="progress" aria-live="polite">
            <div class="row">
              <span>Cargando sitio…</span>
              <span class="soon">pronto<span class="caret">_</span></span>
            </div>
            <span class="bar" aria-hidden="true"><span></span></span>
          </div>

          <div class="actions">
            <a class="btn primary" href={redes[0].href} target="_blank" rel="noopener">Ver GitHub</a>
            <a class="btn" href={redes[1].href} target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
      </article>
    </div>

    <style is:global>
      :root {
        --bg: #eeefe9;
        --bar: #e5e7e0;
        --paper: #fdfdf8;
        --fg: #151515;
        --muted: #65675e;
        --line: #bfc1b7;
        --red: #f54e00;
        --yellow: #f7a501;
        --blue: #1d4aff;
        --highlight: #f7a50166;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #1d1f27;
          --bar: #23252f;
          --paper: #2a2c36;
          --fg: #eeefe9;
          --muted: #9fa1a8;
          --line: #4a4c56;
          --red: #f1662c;
          --yellow: #f7b32b;
          --blue: #5c7cff;
          --highlight: #f7a50140;
          color-scheme: dark;
        }
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        background-color: var(--bg);
        /* Fondo de escritorio: grilla punteada tenue. */
        background-image: radial-gradient(var(--line) 1px, transparent 1px);
        background-size: 22px 22px;
        color: var(--fg);
        font-family: 'IBM Plex Sans', system-ui, sans-serif;
        font-size: 15px;
        line-height: 1.5;
        display: grid;
        grid-template-rows: auto 1fr;
        overflow: hidden;
      }
      a {
        color: inherit;
      }
      code {
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 0.85em;
      }

      .menubar {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        height: 2.5rem;
        padding: 0 1rem;
        background: var(--bar);
        border-bottom: 1px solid var(--line);
        font-size: 13px;
        font-weight: 500;
        position: relative;
        z-index: 2;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        text-decoration: none;
      }
      .mark {
        display: grid;
        place-items: center;
        width: 1.4rem;
        height: 1.4rem;
        border-radius: 4px;
        background: var(--red);
        color: #fff;
        font-size: 10px;
        font-weight: 700;
      }
      .menus {
        display: flex;
        gap: 1.25rem;
        color: var(--muted);
      }
      .menus code {
        color: var(--fg);
      }
      .status {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.1rem 0.6rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--paper);
      }
      .status i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--red);
        animation: pulse 1.6s ease-in-out infinite;
      }
      .clock {
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-variant-numeric: tabular-nums;
      }

      .desktop {
        position: relative;
        min-height: 0;
      }

      .icons {
        list-style: none;
        margin: 0;
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: max-content;
      }
      .icon {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.3rem;
        width: 5.5rem;
        padding: 0.4rem 0.25rem;
        border: 1px solid transparent;
        border-radius: 6px;
        background: none;
        color: inherit;
        font: inherit;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        cursor: pointer;
      }
      .icon svg {
        width: 2.75rem;
        height: 2.75rem;
        transition: transform 0.15s ease;
      }
      .icon:hover,
      .icon:focus-visible {
        background: color-mix(in srgb, var(--blue) 12%, transparent);
        border-color: color-mix(in srgb, var(--blue) 35%, transparent);
        outline: none;
      }
      .icon:hover svg {
        transform: translateY(-2px) rotate(-3deg);
      }

      .window {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(40rem, calc(100vw - 2rem));
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: 8px;
        box-shadow:
          0 1px 0 var(--line),
          0 18px 40px -12px rgb(0 0 0 / 0.25);
        transform: translate(-50%, -50%);
        overflow: hidden;
      }
      .window.dragging {
        box-shadow:
          0 1px 0 var(--line),
          0 28px 60px -14px rgb(0 0 0 / 0.35);
      }
      .window[hidden] {
        display: none;
      }
      .titlebar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 2.25rem;
        padding: 0 0.5rem 0 0.9rem;
        background: var(--bar);
        border-bottom: 1px solid var(--line);
        font-size: 13px;
        font-weight: 600;
        cursor: grab;
        user-select: none;
        touch-action: none;
      }
      .window.dragging .titlebar {
        cursor: grabbing;
      }
      .controls button {
        display: grid;
        place-items: center;
        width: 1.6rem;
        height: 1.6rem;
        border: 0;
        border-radius: 4px;
        background: none;
        color: var(--muted);
        font-size: 12px;
        cursor: pointer;
      }
      .controls button:hover {
        background: color-mix(in srgb, var(--fg) 10%, transparent);
        color: var(--fg);
      }

      .body {
        padding: 2rem 2.25rem 2.25rem;
      }
      .kicker {
        margin: 0 0 0.5rem;
        color: var(--red);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      h1 {
        margin: 0;
        font-size: clamp(2.6rem, 8vw, 4.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.03em;
      }
      h1 mark {
        color: inherit;
        background: linear-gradient(transparent 62%, var(--highlight) 62%);
      }
      .lead {
        margin: 1.1rem 0 0;
        max-width: 32rem;
        color: var(--muted);
        font-size: 1.05rem;
      }

      .progress {
        margin-top: 1.75rem;
        font-size: 13px;
        font-weight: 500;
      }
      .progress .row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.4rem;
        color: var(--muted);
      }
      .soon {
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        color: var(--fg);
      }
      .caret {
        animation: blink 1s steps(1) infinite;
      }
      .bar {
        position: relative;
        display: block;
        height: 0.9rem;
        border: 1px solid var(--fg);
        border-radius: 4px;
        background: var(--bg);
        overflow: hidden;
      }
      .bar span {
        position: absolute;
        inset: 0;
        width: 40%;
        background: repeating-linear-gradient(
          -45deg,
          var(--yellow) 0 8px,
          color-mix(in srgb, var(--yellow) 70%, var(--red)) 8px 16px
        );
        border-right: 1px solid var(--fg);
        animation: fill 3s cubic-bezier(0.65, 0, 0.35, 1) infinite;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.75rem;
      }
      /* Botón "con relieve": borde inferior grueso que se hunde al apretar. */
      .btn {
        display: inline-block;
        padding: 0.55rem 1.1rem;
        border: 1.5px solid var(--fg);
        border-bottom-width: 4px;
        border-radius: 6px;
        background: var(--paper);
        color: var(--fg);
        font-weight: 700;
        text-decoration: none;
        transition: transform 0.1s ease;
      }
      .btn.primary {
        background: var(--yellow);
        color: #151515;
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .btn:active {
        transform: translateY(1px);
        border-bottom-width: 2px;
        margin-top: 2px;
      }

      @media (max-width: 700px) {
        body {
          overflow: auto;
        }
        .menus,
        .clock {
          display: none;
        }
        .desktop {
          display: flex;
          flex-direction: column-reverse;
          justify-content: flex-end;
          gap: 1rem;
          padding: 1rem;
        }
        .window {
          position: static;
          width: 100%;
          transform: none !important;
        }
        .titlebar {
          cursor: default;
        }
        .body {
          padding: 1.5rem 1.25rem;
        }
        .icons {
          flex-direction: row;
          flex-wrap: wrap;
          width: auto;
          padding: 0;
        }
        .icon {
          width: 4.75rem;
        }
      }

      @keyframes pulse {
        50% {
          opacity: 0.25;
        }
      }
      @keyframes fill {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(250%);
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>

    <script>
      const win = document.getElementById('win')!;
      const titlebar = document.getElementById('titlebar')!;
      const clock = document.getElementById('clock')!;
      const mobile = matchMedia('(max-width: 700px)');

      // Ventana arrastrable desde la barra de título, limitada al escritorio.
      // Se guarda el desplazamiento respecto del centro para que siga centrada al redimensionar.
      const offset = { x: 0, y: 0 };
      let start: { x: number; y: number; ox: number; oy: number } | null = null;

      function place() {
        const desk = win.parentElement!.getBoundingClientRect();
        const maxX = Math.max(0, (desk.width - win.offsetWidth) / 2);
        const maxY = Math.max(0, (desk.height - win.offsetHeight) / 2);
        offset.x = Math.max(-maxX, Math.min(maxX, offset.x));
        offset.y = Math.max(-maxY, Math.min(maxY, offset.y));
        win.style.transform = `translate(calc(-50% + ${offset.x}px), calc(-50% + ${offset.y}px))`;
      }

      titlebar.addEventListener('pointerdown', (e) => {
        if (mobile.matches || (e.target as HTMLElement).closest('button')) return;
        start = { x: e.clientX, y: e.clientY, ox: offset.x, oy: offset.y };
        titlebar.setPointerCapture(e.pointerId);
        win.classList.add('dragging');
      });
      titlebar.addEventListener('pointermove', (e) => {
        if (!start) return;
        offset.x = start.ox + e.clientX - start.x;
        offset.y = start.oy + e.clientY - start.y;
        place();
      });
      const stop = () => {
        start = null;
        win.classList.remove('dragging');
      };
      titlebar.addEventListener('pointerup', stop);
      titlebar.addEventListener('pointercancel', stop);
      addEventListener('resize', () => {
        if (!mobile.matches) place();
      });

      // Cerrar la ventana y volver a abrirla desde el ícono del escritorio.
      document.getElementById('close')!.addEventListener('click', () => {
        win.hidden = true;
      });
      document.getElementById('reopen')!.addEventListener('click', () => {
        win.hidden = false;
        offset.x = offset.y = 0;
        if (!mobile.matches) place();
      });

      function tick() {
        clock.textContent = new Date().toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit', hour12: false });
      }
      tick();
      setInterval(tick, 10_000);
    </script>
  </body>
</html>
