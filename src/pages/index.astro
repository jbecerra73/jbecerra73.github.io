---
// Landing temporal mientras se arma el sitio completo (ver _home.astro).
import { execSync } from 'node:child_process';

const redes = [
  { label: 'GitHub', href: 'https://github.com/jbecerra73' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/joaquin-becerra-5b3388201' },
  { label: 'X', href: 'https://x.com/joaquinbecerra_' },
];

let build = 'dev';
try {
  build = (process.env.GITHUB_SHA ?? execSync('git rev-parse HEAD').toString()).trim().slice(0, 7);
} catch {}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Joaquín Becerra</title>
    <meta name="description" content="Joaquín Becerra, software engineer. Sitio en construcción." />
    <link rel="canonical" href="https://joaquinbecerra.me/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Joaquín Becerra" />
    <meta property="og:description" content="Software engineer. Sitio en construcción." />
    <meta property="og:url" content="https://joaquinbecerra.me/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=VT323&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <canvas id="grid" aria-hidden="true"></canvas>

    <header class="hud">
      <span><b>SYS</b> joaquinbecerra.me</span>
      <span><b>ROUTE</b> /</span>
      <span><b>BUILD</b> {build}</span>
      <span class="status"><i></i> BUILDING</span>
    </header>

    <main>
      <p class="kicker">// software engineer</p>
      <h1 id="name">Joaquín<br /><span>Becerra</span></h1>
      <p class="loading" aria-live="polite">
        <span class="label">loading</span>
        <span class="bar" aria-hidden="true"><span></span></span>
        <span class="soon">soon<span class="caret">_</span></span>
      </p>
    </main>

    <footer class="hud bottom">
      <nav>
        {redes.map((r) => <a href={r.href} target="_blank" rel="noopener">{r.label} ↗</a>)}
      </nav>
      <span class="meta">
        <span id="coords" aria-hidden="true">x 0000 · y 0000</span>
        <span><b>LOCAL</b> <time id="clock">--:--:--</time></span>
      </span>
    </footer>

    <style is:global>
      :root {
        --bg: #f4f3ef;
        --fg: #141414;
        --muted: #6b6b66;
        --line: #d9d7d0;
        --dot: #b9b6ad;
        --accent: #ff5b1f;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0c;
          --fg: #eeeeea;
          --muted: #8a8a85;
          --line: #232325;
          --dot: #3a3a3d;
          --accent: #ff6a33;
          color-scheme: dark;
        }
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 12px;
        letter-spacing: 0.02em;
        display: grid;
        grid-template-rows: auto 1fr auto;
        overflow: hidden;
      }
      a {
        color: inherit;
      }

      #grid {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
      }

      .hud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
        padding: 1.25rem 1.5rem;
        color: var(--muted);
        text-transform: uppercase;
        border-bottom: 1px solid var(--line);
        backdrop-filter: blur(2px);
      }
      .hud b {
        color: var(--fg);
        font-weight: 500;
        margin-right: 0.4em;
      }
      .status {
        margin-left: auto;
        color: var(--fg);
      }
      .status i {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent);
        margin-right: 0.5em;
        animation: pulse 1.6s ease-in-out infinite;
      }

      main {
        align-self: center;
        padding: 0 1.5rem;
        max-width: 72rem;
        width: 100%;
        margin: 0 auto;
      }
      .kicker {
        color: var(--muted);
        margin: 0 0 1rem;
      }
      h1 {
        font-family: 'VT323', ui-monospace, monospace;
        font-weight: 400;
        font-size: clamp(5rem, 19vw, 14rem);
        line-height: 0.8;
        letter-spacing: 0;
        margin: 0;
        will-change: transform;
        /* Brillo de fósforo, como un monitor CRT. */
        text-shadow: 0 0 18px color-mix(in srgb, var(--fg) 22%, transparent);
      }
      h1 span {
        color: var(--muted);
        text-shadow: none;
      }

      .loading {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 2.25rem 0 0;
        text-transform: uppercase;
        color: var(--muted);
      }
      .bar {
        position: relative;
        width: min(14rem, 40vw);
        height: 2px;
        background: var(--line);
        overflow: hidden;
      }
      .bar span {
        position: absolute;
        inset: 0;
        width: 35%;
        background: var(--accent);
        animation: scan 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
      }
      .soon {
        color: var(--fg);
      }
      .caret {
        animation: blink 1s steps(1) infinite;
      }

      .bottom {
        border-bottom: 0;
        border-top: 1px solid var(--line);
        justify-content: space-between;
      }
      .bottom nav {
        display: flex;
        gap: 1.5rem;
      }
      .bottom a {
        color: var(--fg);
        text-decoration: none;
      }
      .bottom a:hover {
        color: var(--accent);
      }
      .meta {
        display: flex;
        gap: 2rem;
      }

      @media (max-width: 600px) {
        .hud {
          padding: 1rem;
          gap: 0.4rem 1.25rem;
        }
        main {
          padding: 0 1rem;
        }
        #coords {
          display: none;
        }
      }

      @keyframes pulse {
        50% {
          opacity: 0.25;
        }
      }
      @keyframes scan {
        from {
          transform: translateX(-100%);
        }
        to {
          transform: translateX(290%);
        }
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
        }
      }
    </style>

    <script>
      const canvas = document.getElementById('grid') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const name = document.getElementById('name')!;
      const coords = document.getElementById('coords')!;
      const clock = document.getElementById('clock')!;
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const GAP = 26;
      const RADIUS = 160;
      let w = 0;
      let h = 0;
      let colors = { dot: '', accent: '' };

      // Posición real del puntero y una versión suavizada que la persigue.
      // `presence` sube a 1 mientras el cursor está en la ventana y baja a 0 al salir,
      // así el efecto se desvanece en el lugar en vez de salir disparado.
      const target = { x: 0, y: 0 };
      const pos = { x: 0, y: 0 };
      const shift = { x: 0, y: 0 };
      let inside = false;
      let presence = 0;

      function readColors() {
        const s = getComputedStyle(document.documentElement);
        colors = { dot: s.getPropertyValue('--dot').trim(), accent: s.getPropertyValue('--accent').trim() };
      }

      function resize() {
        const dpr = Math.min(devicePixelRatio || 1, 2);
        w = innerWidth;
        h = innerHeight;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (reduceMotion) draw(0);
      }

      function draw(t: number) {
        pos.x += (target.x - pos.x) * 0.12;
        pos.y += (target.y - pos.y) * 0.12;
        presence += ((inside ? 1 : 0) - presence) * 0.08;
        ctx.clearRect(0, 0, w, h);

        const offX = (w % GAP) / 2;
        const offY = (h % GAP) / 2;
        for (let x = offX; x <= w; x += GAP) {
          for (let y = offY; y <= h; y += GAP) {
            const dx = x - pos.x;
            const dy = y - pos.y;
            const d = Math.hypot(dx, dy);
            const k = d < RADIUS ? (1 - d / RADIUS) ** 2 * presence : 0;
            // Ondulación lenta para que la grilla respire aunque no haya cursor (ej. en mobile).
            const wave = reduceMotion ? 0 : Math.sin(t * 0.0012 + (x + y) * 0.012) * 0.5 + 0.5;
            const push = k * 14;
            const px = d ? x + (dx / d) * push : x;
            const py = d ? y + (dy / d) * push : y;

            ctx.globalAlpha = 0.6 + wave * 0.4 + k * 0.4;
            ctx.fillStyle = k > 0.05 ? colors.accent : colors.dot;
            ctx.beginPath();
            ctx.arc(px, py, 0.9 + k * 2.2 + wave * 0.25, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.globalAlpha = 1;

        // Parallax suave del nombre siguiendo al cursor.
        shift.x += ((pos.x / w - 0.5) * -18 * presence - shift.x) * 0.1;
        shift.y += ((pos.y / h - 0.5) * -10 * presence - shift.y) * 0.1;
        name.style.transform = `translate3d(${shift.x}px, ${shift.y}px, 0)`;

        if (!reduceMotion) requestAnimationFrame(draw);
      }

      function onPointer(e: PointerEvent) {
        target.x = e.clientX;
        target.y = e.clientY;
        if (presence < 0.01) {
          pos.x = target.x;
          pos.y = target.y;
        }
        inside = true;
        coords.textContent = `x ${String(Math.round(e.clientX)).padStart(4, '0')} · y ${String(Math.round(e.clientY)).padStart(4, '0')}`;
        if (reduceMotion) draw(0);
      }

      addEventListener('pointermove', onPointer, { passive: true });
      addEventListener('pointerdown', onPointer, { passive: true });
      document.addEventListener('mouseout', (e) => {
        if (!e.relatedTarget) inside = false;
      });
      addEventListener('resize', resize);
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        readColors();
        if (reduceMotion) draw(0);
      });

      function tick() {
        clock.textContent = new Date().toLocaleTimeString('es', { hour12: false });
      }

      readColors();
      resize();
      tick();
      setInterval(tick, 1000);
      if (!reduceMotion) requestAnimationFrame(draw);
    </script>
  </body>
</html>
